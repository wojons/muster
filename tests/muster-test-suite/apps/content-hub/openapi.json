          "404": {
            "description": "Post not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/posts/{post_id}/publish": {
      "put": {
        "operationId": "publishPost",
        "summary": "Publish a post",

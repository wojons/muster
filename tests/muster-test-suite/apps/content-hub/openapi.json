  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer token authentication. Use one of: reader-token, author-token, editor-token, admin-token."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          }
        }
      },
      "Author": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Author ID"
          },
          "name": {
            "type": "string",
            "description": "Author display name"
          },
          "email": {
            "type": "string",
            "description": "Author email address"
          },
          "bio": {
            "type": "string",
            "description": "Author biography"
          },
          "avatar_url": {
            "type": "string",
            "description": "URL to author avatar"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 creation timestamp"
          }
        }
      },
      "AuthorDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Author"
          },
          {
            "type": "object",
            "properties": {
              "post_count": {
                "type": "integer",
                "description": "Number of published posts by this author"
              },
              "posts": {
                "type": "array",
                "description": "List of published posts by this author",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["draft", "published"]
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "CreateAuthorRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Author display name"
          },
          "email": {
            "type": "string",
            "description": "Author email address"
          },
          "bio": {
            "type": "string",
            "description": "Author biography"
          },
          "avatar_url": {
            "type": "string",
            "description": "URL to author avatar"
          }
        }
      },
      "UpdateAuthorRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Author display name"
          },
          "email": {
            "type": "string",
            "description": "Author email address"
          },
          "bio": {
            "type": "string",
            "description": "Author biography"
          },
          "avatar_url": {
            "type": "string",
            "description": "URL to author avatar"
          }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Post ID"
          },
          "title": {
            "type": "string",
            "description": "Post title"
          },
          "content": {
            "type": "string",
            "description": "Post body content"
          },
          "author_id": {
            "type": "integer",
            "nullable": true,
            "description": "ID of the author"
          },
          "author_name": {
            "type": "string",
            "description": "Email of the authenticated user who created the post"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of tags"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "published"],
            "description": "Publication status"
          },
          "excerpt": {
            "type": "string",
            "description": "Short excerpt or summary"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 last update timestamp"
          }
        }
      },
      "CreatePostRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Post title"
          },
          "content": {
            "type": "string",
            "description": "Post body content"
          },
          "author_id": {
            "type": "integer",
            "description": "ID of the author (optional, stored for reference)"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of tags"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "published"],
            "description": "Publication status. Authors always create as draft; editors/admins may create as published."
          },
          "excerpt": {
            "type": "string",
            "description": "Short excerpt or summary"
          }
        }
      },
      "UpdatePostRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Post title"
          },
          "content": {
            "type": "string",
            "description": "Post body content"
          },
          "author_id": {
            "type": "integer",
            "description": "ID of the author"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of tags"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "published"],
            "description": "Publication status. Only editors/admins can set to published."
          },
          "excerpt": {
            "type": "string",
            "description": "Short excerpt or summary"
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Comment ID"
          },
          "post_id": {
            "type": "integer",
            "description": "ID of the parent post"
          },
          "content": {
            "type": "string",
            "description": "Comment body text"
          },
          "author_name": {
            "type": "string",
            "description": "Display name of the comment author"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 creation timestamp"
          }
        }
      },
      "CreateCommentRequest": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": {
            "type": "string",
            "description": "Comment body text"
          },
          "author_name": {
            "type": "string",
            "description": "Display name of the comment author (defaults to authenticated user)"
          }
        }
      },
      "UpdateCommentRequest": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Comment body text"
          },
          "author_name": {
            "type": "string",
            "description": "Display name of the comment author"
          }
        }
      },
      "CommentList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "total": {
            "type": "integer",
            "description": "Total number of comments"
          }
        }
      },
      "DeletedResponse": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Whether the deletion was successful",
            "example": true
          },
          "comments_deleted": {
            "type": "integer",
            "description": "Number of associated comments also deleted",
            "example": 3
          }
        }
      },
      "CommentDeletedResponse": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Whether the deletion was successful",
            "example": true
          }
        }
      },
      "PaginatedAuthors": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Author"
            }
          },
          "page": {
            "type": "integer",
            "description": "Current page number"
          },
          "per_page": {
            "type": "integer",
            "description": "Items per page"
          },
          "total": {
            "type": "integer",
            "description": "Total number of items"
          },
          "pages": {
            "type": "integer",
            "description": "Total number of pages"
          }
        }
      },
      "PaginatedPosts": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "page": {
            "type": "integer",
            "description": "Current page number"
          },
          "per_page": {
            "type": "integer",
            "description": "Items per page"
          },
          "total": {
            "type": "integer",
            "description": "Total number of items"
          },
          "pages": {
            "type": "integer",
            "description": "Total number of pages"
          }
        }
      }
    }
  }
}

#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	go build -ldflags="-s -w" -o bin/openapi-cli ./cmd/openapi-cli
	go build -ldflags="-s -w" -o bin/openapi-mcp ./cmd/mcp-server

override_dh_auto_install:
	install -D -m 755 bin/openapi-cli debian/openapi-cli/usr/bin/openapi-cli
	install -D -m 755 bin/openapi-mcp debian/openapi-mcp/usr/bin/openapi-mcp

override_dh_strip:
	dh_strip -Xopenapi-cli
	dh_strip -Xopenapi-mcp

override_dh_auto_clean:
	rm -rf bin/

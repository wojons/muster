{
  "asyncapi": "3.0.0",
  "info": {"title": "Multi Server", "version": "1.0.0"},
  "servers": {
    "kafka-east": {"host": "east:9092", "protocol": "kafka"},
    "kafka-west": {"host": "west:9092", "protocol": "kafka"}
  },
  "channels": {
    "c1": {"address": "topic-one", "messages": {"M": {"payload": {"type": "object"}}}}
  },
  "operations": {
    "op1": {
      "action": "send",
      "channel": {"$ref": "#/channels/c1"},
      "messages": [{"$ref": "#/channels/c1/messages/M"}]
    }
  }
}

+      fi
+    fi
+    if qa_seccomp_dev_ready; then
+      cell toolchain-bootstrap OK "native build prereq provisioned for libseccomp-linked trees: pkg-config=\$(command -v pkg-config), libseccomp \$(pkg-config --modversion libseccomp 2>/dev/null) from user-space sysroot \$QA_SYSROOT (no sudo) — QA-MUSTER-13-R2"

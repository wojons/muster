+# ─── QA-MUSTER-13-R2 (2026-11-21): native build prerequisites for trees that
+# link libseccomp ────────────────────────────────────────────────────────────
+# WHY: the fresh-install and upgrade cells compile the repo's cgo dependency
+# github.com/seccomp/libseccomp-golang (its cgo line is \`pkg-config: libseccomp\`).
+# A clean JIT agent ships NO libseccomp development files, so those builds died on
+# a HARNESS-ENV gap and graded the repo FAIL:
+#   upgrade FAIL "previous release v0.1.0 would not build (streamed tree):
+#     ... exec: \"pkg-config\": executable file not found in \$PATH"
+#   upgrade FAIL "... Package libseccomp was not found in the pkg-config search path"
+# (muster QA-MUSTER-13 + this recurrence; controller repro: with pkg-config and
+# libseccomp.pc present the SAME streamed tree builds rc=0, so the whole mechanism
+# is battery-side provisioning and no product file changes). Provision BEFORE any
+# build cell — and derive the need from the trees about to be built (this tree's
+# go.mod/go.sum and the host-streamed previous-release tree), so a repo that does
+# not link libseccomp pays nothing and installs nothing:
+#   1 already present   -> one INFO line, no install attempt (idempotent)
+#   2 root              -> distro package manager installs pkg-config + libseccomp-dev
+#   3 no root (agents)  -> user-space sysroot in ~/tools/sysroot: \`apt-get download\`
+#                          or \`apk fetch\` unprivileged, \`dpkg-deb -x\`/\`tar\` extract,
+#                          rewrite each .pc prefix onto the sysroot, export
+#                          PKG_CONFIG_PATH/CGO_CFLAGS/CGO_LDFLAGS/LIBRARY_PATH so
+#                          pkg-config AND the C linker resolve the library there.
+#                          A sysroot left by an earlier battery on a kept agent is
+#                          reused instead of re-downloaded.
+#   4 cannot provision  -> QA_NATIVE_SYSDEPS_BLOCKED=<reason>, and the build cells
+#                          grade ENV-BLOCKED naming it instead of grading the repo
+#                          FAIL on a prerequisite the agent never had.
+QA_NATIVE_SYSDEPS_BLOCKED=""
+qa_needs_seccomp_dev() { # 0 = a tree we are about to build links libseccomp
+  local f
+  for f in go.mod go.sum "\$HOME/qa-up-prev/go.mod" "\$HOME/qa-up-prev/go.sum"; do
+    [ -f "\$f" ] && grep -qi 'libseccomp' "\$f" 2>/dev/null && return 0
+  done
+  return 1
+}
+qa_seccomp_dev_ready() { # 0 = pkg-config answers for libseccomp
+  command -v pkg-config >/dev/null 2>&1 || return 1
+  pkg-config --exists libseccomp >/dev/null 2>&1
+}
+qa_native_prereq_failure() { # <log> — 0 = log carries a native-prereq signature
+  grep -qiE 'exec: "pkg-config"|pkg-config: (executable file )?not found|pkg-config search path|Package libseccomp was not found|seccomp\.h: (No such file|not found)|fatal error: seccomp\.h' "\$1" 2>/dev/null
+}
+qa_seccomp_sysroot_export() { # <sysroot> — export the sysroot into pkg-config + cgo
+  local sr="\$1" pcdir libdir
+  pcdir="\$(find "\$sr" -name 'libseccomp.pc' -exec dirname {} \; 2>/dev/null | head -1)"
+  libdir="\$(find "\$sr" -name 'libseccomp.so' -exec dirname {} \; 2>/dev/null | head -1)"
+  [ -z "\$libdir" ] && libdir="\$(find "\$sr" -name 'libseccomp.so.*' -exec dirname {} \; 2>/dev/null | head -1)"
+  [ -n "\$pcdir" ] && export PKG_CONFIG_PATH="\$pcdir\${PKG_CONFIG_PATH:+:\$PKG_CONFIG_PATH}"
+  [ -n "\$libdir" ] && export LIBRARY_PATH="\$libdir\${LIBRARY_PATH:+:\$LIBRARY_PATH}"
+  [ -n "\$libdir" ] && export LD_LIBRARY_PATH="\$libdir\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
+  [ -d "\$sr/usr/include" ] && export CGO_CFLAGS="\${CGO_CFLAGS:-} -I\$sr/usr/include"
+  [ -n "\$libdir" ] && export CGO_LDFLAGS="\${CGO_LDFLAGS:-} -L\$libdir"
+  return 0
+}
+if qa_needs_seccomp_dev; then
+  if qa_seccomp_dev_ready; then
+    cell toolchain-bootstrap INFO "native build prereq already present: pkg-config + libseccomp.pc \$(pkg-config --modversion libseccomp 2>/dev/null) — nothing installed (QA-MUSTER-13-R2)"
+  else
+    QA_SYSROOT="\$HOME/tools/sysroot"
+    QA_PM=""
+    for qa_c in apt-get dnf yum apk; do command -v "\$qa_c" >/dev/null 2>&1 && { QA_PM="\$qa_c"; break; }; done

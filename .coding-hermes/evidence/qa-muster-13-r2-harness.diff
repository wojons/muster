+    fi
+  fi
+fi
+# ─── QA-MUSTER-13-R2 (2026-11-21): honor the toolchain the module documents when
+# the agent's newest go refuses a PREBUILT archive ─────────────────────────────
+# WHY: go1.26.11/1.27.4+ implement the CVE-2026-97038 cgo hardening — the go
+# command scans the -L dirs of #cgo LDFLAGS and rejects archives carrying LTO
+# bitcode (isDisallowedLTOSection / .llvmbc in cmd/go/internal/work/security.go).
+# muster v0.1.0 vendors wasmtime-go v8's prebuilt libwasmtime.a, which carries
+# .llvmbc, so on a newest-go agent the streamed previous tree died with
+#   github.com/bytecodealliance/wasmtime-go/v8: disallowed LTO section ".llvmbc"
+#   in #cgo LDFLAGS: .../libwasmtime.a
+# even with libseccomp.pc provisioned — a second missing native-build
+# prerequisite, and NOT a repo defect (the module documents its own floor:
+# \`go 1.26.1\`, a toolchain that predates the check). The agent's newest-go
+# selection is QA-MUSTER-051's business and is untouched here; this is a single,
+# bounded retry that fires ONLY on that exact signature, uses the toolchain the
+# module documents, and writes both attempts into the same cell log.
+QA_TOOLCHAIN_FALLBACK=""
+qa_go_module_floor() { # <dir> -> the \`go\` directive of that dir's go.mod
+  sed -n 's/^go[[:space:]]\{1,\}\([0-9][0-9.]*\).*/\1/p' "\$1/go.mod" 2>/dev/null | head -1
+}
+qa_toolchain_lto_rejection() { # <log> — 0 = the go command refused a prebuilt LTO archive
+  grep -qiE 'disallowed LTO (section|segment)|disallowed LLVM LTO section' "\$1" 2>/dev/null
+}
+qa_retry_with_documented_go() { # <log> <dir> <cmd> [timeout-s] — one bounded retry
+  local log="\$1" dir="\$2" cmd="\$3" tmo="\${4:-}" floor gov rc
+  floor="\$(qa_go_module_floor "\$dir")"
+  [ -n "\$floor" ] || return 1
+  gov="\$(go version 2>/dev/null | sed 's/^go version go\([^ ]*\).*/\1/')"
+  {
+    printf '\n=== QA-MUSTER-13-R2: this agent go (%s) rejects a prebuilt archive that carries LLVM bitcode (CVE-2026-97038 cgo LTO check) — not a repo defect.\n' "\${gov:-unknown}"
+    printf '=== retrying ONCE with the toolchain the module documents (go.mod: go %s) via GOTOOLCHAIN=go%s\n' "\$floor" "\$floor"
+  } >> "\$log"
+  if [ -n "\$tmo" ]; then
+    ( cd "\$dir" && GOTOOLCHAIN="go\$floor" timeout "\$tmo" bash -c "\$cmd" ) >> "\$log" 2>&1
+  else
+    ( cd "\$dir" && GOTOOLCHAIN="go\$floor" bash -c "\$cmd" ) >> "\$log" 2>&1
+  fi
+  rc=\$?
+  printf 'TOOLCHAIN-FALLBACK GOTOOLCHAIN=go%s rc=%s\n' "\$floor" "\$rc" >> "\$log"
+  [ "\$rc" -eq 0 ] && QA_TOOLCHAIN_FALLBACK="go\$floor"
+  return "\$rc"
+}

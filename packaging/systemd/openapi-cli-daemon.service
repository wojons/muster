[Unit]
Description=OpenAPI CLI Daemon
Documentation=https://docs.openapi-cli.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muster
Group=muster
ExecStart=/usr/bin/openapi-daemon start --foreground --socket-path /run/muster/daemon.sock
ExecStartPre=/bin/mkdir -p /run/muster
ExecStartPost=/bin/chown -R muster:muster /run/muster
Restart=on-failure
RestartSec=5s

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/muster /var/lib/openapi-cli /var/log/openapi-cli

# Resource Limits
MemoryLimit=512M
CPUQuota=200%

# Capability filtering
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW

# Seccomp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.muster.app</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/muster</string>
        <string>daemon</string>
        <string>start</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    
    <key>ThrottleInterval</key>
    <integer>60</integer>
    
    <key>StandardOutPath</key>
    <string>/Users/$USER/Library/Logs/com.muster.app/stdout.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/$USER/Library/Logs/com.muster.app/stderr.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/$USER</string>
        <key>MUSTER_HOME</key>
        <string>/Users/$USER/.muster</string>
    </dict>
</dict>
</plist>
